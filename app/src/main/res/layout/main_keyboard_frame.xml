<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical" >

    <!--
        keyboard-cipher: la riga di composizione. Il chiaro si scrive qui e
        l'app riceve solo il blob.

        `gone` per default: a modalita' spenta non deve costare un pixel di
        altezza, e in un LinearLayout verticale una vista `gone` non ne occupa.

        Altezza FISSA: crescendo mentre si scrive faceva crescere la tastiera, e
        l'app di chat non sempre rifa' il proprio layout in tempo — la riga
        finiva per coprire la casella di testo dell'app. Il testo piu' lungo
        scorre, e lo scorrimento insegue il cursore.
    -->
    <LinearLayout
        android:id="@+id/cipher_compose_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cipher_compose_row_height"
        android:orientation="vertical"
        android:visibility="gone">

        <!--
            Sopra: il testo e i due tasti che si premono di piu' — invia in
            chiaro e invia cifrato. Stanno QUI e non solo in barra perche' la
            barra sparisce: aprendo le emoji o la cronologia appunti viene
            sostituita da quella delle categorie, e con essa se ne va il modo di
            spedire. Chi finisce un messaggio con una faccina si trovava senza
            uscita.

            Sono piu' grandi degli altri tasti perche' sono i due che si usano
            di continuo, e perche' qui non competono con i suggerimenti: nella
            striscia ogni pixel e' larghezza tolta alle parole, in questa riga
            no.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <helium314.keyboard.cipher.CipherComposeView
                android:id="@+id/cipher_compose_row"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:textSize="16sp"
                android:hint="@string/cipher_compose_hint"
                android:textDirection="locale"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="12dp" />

            <ImageButton
                android:id="@+id/cipher_compose_send"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_cipher_encrypt"
                android:contentDescription="@string/cipher_encrypt_action" />

            <ImageButton
                android:id="@+id/cipher_compose_plain"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scaleType="fitCenter"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_cipher_plain"
                android:contentDescription="@string/cipher_send_plain_action" />
        </LinearLayout>

        <!--
            Sotto: per chi si sta cifrando. Toccandolo si cambia.

            E' l'unica informazione che l'utente non ha modo di conoscere prima
            di premere il lucchetto — la tastiera non sa con chi stai parlando —
            e una scelta invisibile e' una scelta che sorprende. Sta su una riga
            sua, sotto i tasti, perche' e' uno stato e non un'azione: mescolarlo
            ai due tasti lo faceva sembrare un terzo pulsante.
        -->
        <TextView
            android:id="@+id/cipher_recipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp" />
    </LinearLayout>

    <include
        android:id="@+id/strip_container"
        layout="@layout/strip_container" />

    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <helium314.keyboard.latin.KeyboardWrapperView
        android:id="@+id/keyboard_view_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr" >

        <helium314.keyboard.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include
            android:id="@+id/emoji_palettes_view"
            layout="@layout/emoji_palettes_view" />
        <include
            android:id="@+id/clipboard_history_view"
            layout="@layout/clipboard_history_view" />

        <!-- keyboard-cipher: il menu a tendina della selezione. Si sovrappone
             ai tasti e non occupa altezza propria. -->
        <include layout="@layout/cipher_selection_menu" />

        <!-- keyboard-cipher: il messaggio decifrato, dentro la tastiera.
             Vedi CipherPanel. -->
        <include layout="@layout/cipher_message_panel" />

        <ImageButton
            android:id="@+id/btn_stop_one_handed_mode"
            android:contentDescription="@string/label_stop_onehanded_mode_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_switch_one_handed_mode"
            android:contentDescription="@string/label_switch_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_resize_one_handed_mode"
            android:contentDescription="@string/label_resize_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageView
            android:id="@+id/backgroundGatheringIndicator"
            android:visibility="visible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/btn_keyboard_key_action_normal_lxx_base"
            android:tint="#a00000"
            android:layout_gravity="top"
            />
    </helium314.keyboard.latin.KeyboardWrapperView>
    <LinearLayout
        android:id="@+id/float_handle_container"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/resize_handle"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_arrow_horizontal"/>
        <ImageView
            android:id="@+id/drag_handle"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/config_floating_handle_height"
            android:src="@drawable/ic_drag_indicator"/>
    </LinearLayout>
</LinearLayout>
