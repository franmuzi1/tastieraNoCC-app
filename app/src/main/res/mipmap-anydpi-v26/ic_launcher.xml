<?xml version="1.0" encoding="utf-8"?>
<!--
    Icona adattiva di MusyBoard.

    Il disegno e' un tondo, e nell'icona adattiva sta nei 72dp centrali dei 108
    del foglio: e' l'area che il sistema lascia vedere, quindi con la maschera
    circolare il tondo la riempie esatto, anello compreso. Piu' grande verrebbe
    tagliato l'anello, piu' piccolo galleggerebbe in mezzo allo sfondo.

    Lo sfondo e' un colore pieno preso dal disegno stesso: si vede solo negli
    angoli, sui lanciatori che usano una maschera squadrata.

    Niente `monochrome`: quel canale vuole una silhouette piatta, e dandogli
    un'immagine il tema scuro dei lanciatori la ridurrebbe a una macchia. Senza,
    chi ha le icone a tema vede semplicemente l'icona normale.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
