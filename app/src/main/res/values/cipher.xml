<?xml version="1.0" encoding="utf-8"?>
<!--
    Risorse di keyboard-cipher.
    Tenute in un file separato per non mescolarsi con quelle di HeliBoard:
    rende ovvio cosa e' del fork quando si fa un merge da upstream.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Etichetta della voce che compare nella barra di selezione del testo
        (ACTION_PROCESS_TEXT) e nello share sheet. La vede l'utente dentro
        un'altra app, quindi deve essere corta e comprensibile da sola.

        tools:ignore="MissingTranslation": le traduzioni di HeliBoard arrivano
        da Weblate, e le stringhe del fork non ci passano. Senza, lint segnala
        un errore per ognuna delle 85 lingue del progetto. Da togliere se un
        giorno le stringhe del fork entrano in un flusso di traduzione.
    -->
    <string name="cipher_decrypt_action" tools:ignore="MissingTranslation">Decifra</string>

    <!--
        Etichette dei due tasti in toolbar.

        I nomi NON sono liberi: `createToolbarKey` costruisce la
        contentDescription con `key.name.lowercase()`, quindi devono chiamarsi
        come le voci di ToolbarKey. Se mancassero, la descrizione diventerebbe
        la stringa "encrypt", che TalkBack leggerebbe cosi' com'e'.
    -->
    <string name="encrypt" tools:ignore="MissingTranslation">Cifra</string>
    <string name="decrypt" tools:ignore="MissingTranslation">Decifra</string>

    <!-- Messaggi dei due gesti. Vedi CipherActions. -->
    <string name="cipher_nothing_to_encrypt" tools:ignore="MissingTranslation">Niente da cifrare</string>
    <string name="cipher_nothing_to_decrypt" tools:ignore="MissingTranslation">Niente da decifrare</string>
    <!--
        Non "errore": il core non sa con chi stai parlando e non lo indovina.
        Cifrare per la persona sbagliata sarebbe il fallimento peggiore
        possibile, quindi qui si chiede.
    -->
    <string name="cipher_no_recipient" tools:ignore="MissingTranslation">Scegli prima un destinatario per questa app</string>
    <string name="cipher_message_too_long" tools:ignore="MissingTranslation">Messaggio troppo lungo per questa chat</string>
    <string name="cipher_message_too_long_detail" tools:ignore="MissingTranslation">Il testo cifrato supera il limite di 4096 caratteri di Telegram: togli circa %1$d caratteri, oppure mandalo in due messaggi.</string>
    <string name="cipher_text_too_long" tools:ignore="MissingTranslation">Testo troppo lungo per essere cifrato</string>
    <!-- Riga di composizione: il chiaro resta nella tastiera fino al lucchetto. -->
    <string name="cipher_settings_category" tools:ignore="MissingTranslation">Cifratura</string>
    <string name="cipher_compose_mode" tools:ignore="MissingTranslation">Scrivi dentro la tastiera</string>
    <string name="cipher_compose_mode_summary" tools:ignore="MissingTranslation">Il testo in chiaro resta nella tastiera e l\'app riceve solo il messaggio cifrato, quando premi il lucchetto. Senza, il chiaro passa dal campo dell\'app — che puo\' salvarlo come bozza gia\' prima che tu cifri.</string>
    <string name="cipher_enabled" tools:ignore="MissingTranslation">Cifratura attiva</string>
    <string name="cipher_enabled_summary" tools:ignore="MissingTranslation">Spegnendola, la tastiera si comporta come una tastiera normale: niente tasti di cifratura, niente riga di composizione. Le tue chiavi e i tuoi contatti restano dove sono.</string>
    <string name="cipher_nothing_to_send" tools:ignore="MissingTranslation">Niente da inviare</string>
    <string name="cipher_sent_plain" tools:ignore="MissingTranslation">Messo nel campo in chiaro, non cifrato</string>
    <!--
        Descrizione del tasto per TalkBack. Il nome viene dal nome della voce
        dell'enum in minuscolo, quindi questa stringa si deve chiamare cosi'.
    -->
    <string name="send_plain" tools:ignore="MissingTranslation">Consegna in chiaro</string>
    <!--
        Altezza FISSA della riga, non `wrap_content`.

        Crescendo mentre si scrive faceva crescere la tastiera, e l'app di chat
        non sempre rifa' il proprio layout in tempo: il risultato era la riga
        che copriva la casella di testo dell'app. Un'altezza costante toglie di
        mezzo tutta la classe di problema; il testo piu' lungo scorre, e lo
        scorrimento insegue il cursore.
    -->
    <dimen name="cipher_compose_row_height">56dp</dimen>
    <!-- Nome del tasto per TalkBack: deve chiamarsi come la voce dell'enum. -->
    <string name="compose" tools:ignore="MissingTranslation">Scrivi dentro la tastiera</string>
    <string name="cipher_compose_on" tools:ignore="MissingTranslation">Ora scrivi dentro la tastiera: l\'app vedra\' solo il messaggio cifrato</string>
    <string name="cipher_compose_off" tools:ignore="MissingTranslation">Ora scrivi nel campo dell\'app, come una tastiera normale</string>
    <string name="cipher_auto_send" tools:ignore="MissingTranslation">Invia subito</string>
    <string name="cipher_auto_send_summary" tools:ignore="MissingTranslation">Dopo aver cifrato, chiede all\'app di spedire il messaggio: un tocco invece di due. Funziona solo dove il campo di scrittura ha un\'azione di invio — in Telegram va acceso «Invia con Invio» nelle impostazioni delle chat.</string>
    <string name="cipher_send_unavailable" tools:ignore="MissingTranslation">Messaggio pronto nel campo: questa app non lascia spedire dalla tastiera, premi tu invio</string>
    <!-- File cifrati (decisione G). -->
    <string name="cipher_file_send" tools:ignore="MissingTranslation">Manda un file cifrato</string>
    <string name="cipher_file_too_big" tools:ignore="MissingTranslation">File troppo grande: su questo telefono il limite e\' %1$d MB</string>
    <string name="cipher_file_detail" tools:ignore="MissingTranslation">%1$s — %2$d KB</string>
    <string name="cipher_file_received" tools:ignore="MissingTranslation">File cifrato</string>
    <string name="cipher_file_save" tools:ignore="MissingTranslation">Salva</string>
    <string name="cipher_file_saved" tools:ignore="MissingTranslation">Salvato. Da qui in poi e\' un file come gli altri: entra nella galleria e nei backup.</string>
    <string name="cipher_pick_recipient" tools:ignore="MissingTranslation">A chi stai scrivendo?</string>
    <string name="cipher_pick_no_contacts" tools:ignore="MissingTranslation">Nessun contatto ancora. Fatti mandare la presentazione di qualcuno, oppure mandagli la tua: tieni premuto il lucchetto chiuso e invia.</string>
    <string name="cipher_no_recipient_short" tools:ignore="MissingTranslation">→ a chi?</string>
    <string name="cipher_auto_open" tools:ignore="MissingTranslation">Apri da solo i messaggi copiati</string>
    <string name="cipher_auto_open_summary" tools:ignore="MissingTranslation">Quando copi un messaggio cifrato, la tastiera lo apre senza che tu prema niente. Funziona solo con la cronologia appunti attiva: e\' li\' che il testo viene gia\' letto, e leggerlo di nostra iniziativa farebbe della tastiera un\'app che spia gli appunti.</string>
    <string name="cipher_forward_secrecy" tools:ignore="MissingTranslation">Forward secrecy</string>
    <string name="cipher_forward_secrecy_summary" tools:ignore="MissingTranslation">Ogni messaggio porta una chiave nuova, e leggere una risposta butta le vecchie. Chi domani ti prendesse il telefono e la tua chiave non riaprirebbe quello che hai gia\' mandato. Il prezzo: i messaggi si aprono una volta sola, e riaprire una vecchia conversazione non sara\' piu\' possibile — nemmeno esportandola. Spegnila se ti serve poterla rileggere. Richiede che chi riceve abbia questa versione o piu\' recente e che tu sia gia\' fra i suoi contatti.</string>
    <string name="cipher_forget" tools:ignore="MissingTranslation">Dimentica questo contatto</string>
    <string name="cipher_forget_title" tools:ignore="MissingTranslation">Dimenticare %1$s?</string>
    <string name="cipher_forget_warning" tools:ignore="MissingTranslation">Perdi il collegamento fra questa chiave e questa persona. Il prossimo messaggio che ti manda ricomparira\' come mittente mai visto e verra\' memorizzato di nuovo senza dire niente: e\' la stessa cosa che vedresti se qualcuno si stesse spacciando per lei. Si perde anche «ho confrontato di persona».</string>
    <string name="cipher_forgotten" tools:ignore="MissingTranslation">Contatto dimenticato</string>
    <string name="cipher_compose_hint" tools:ignore="MissingTranslation">Scrivi qui: l\'app non lo vede</string>
    <!--
        Il campo non si e' lasciato sostituire: parte del chiaro e' rimasta
        accanto al blob. Va detto, e va detto in modo che si capisca cosa fare
        prima di premere invio.
    -->
    <string name="cipher_replace_failed" tools:ignore="MissingTranslation">Questa app non ha lasciato sostituire il testo: controlla il campo, potrebbe esserci ancora del testo in chiaro</string>
    <!--
        Dice "invia", non "fatto": la card e\' nel campo ma non e\' ancora
        partita, e senza l\'invio il primo contatto non si chiude.
    -->
    <string name="cipher_card_inserted" tools:ignore="MissingTranslation">La tua presentazione e\' nel campo: invia per farti riconoscere</string>
    <string name="cipher_locked" tools:ignore="MissingTranslation">Sblocca il dispositivo per cifrare</string>
    <string name="cipher_unavailable" tools:ignore="MissingTranslation">Cifratura non disponibile</string>

    <!--
        Schermate di DecryptActivity.

        "non e' cifrato" NON e' un errore: e' l'esito piu' comune, perche' la
        maggior parte del testo che passa di qui non e' nostra.
    -->
    <string name="cipher_not_our_blob" tools:ignore="MissingTranslation">Questo testo non e\' cifrato</string>
    <!--
        Un blob prodotto da una versione futura deve dire "aggiorna", non
        "non e\' cifrato". E\' la ragione per cui la versione sta nel primo byte
        del body e non nel sentinel: con la versione nel sentinel il
        riconoscimento fallirebbe e l\'utente leggerebbe il messaggio sbagliato.
    -->
    <string name="cipher_version_too_new" tools:ignore="MissingTranslation">Messaggio creato con una versione piu\' recente. Aggiorna l\'app.</string>
    <string name="cipher_tier_unsupported" tools:ignore="MissingTranslation">Questo messaggio usa una modalita\' non ancora supportata</string>
    <!--
        UN solo messaggio per qualunque fallimento crypto. Non aggiungere
        varianti: distinguere le cause e\' un canale che aiuta chi attacca, ed
        e\' il motivo per cui il core restituisce un errore opaco.
    -->
    <string name="cipher_cannot_decrypt" tools:ignore="MissingTranslation">Non si apre. Puo\' essere diretto a qualcun altro, oppure gia\' aperto una volta: con la forward secrecy accesa un messaggio si apre una volta sola, e la sua chiave non torna.</string>
    <string name="cipher_own_message_to" tools:ignore="MissingTranslation">A %1$s</string>
    <string name="cipher_own_message_note" tools:ignore="MissingTranslation">L\'hai scritto tu. Si riapre perche\' la forward secrecy era spenta: con quella accesa non sarebbe possibile, nemmeno per te.</string>
    <string name="cipher_own_message_no_peer" tools:ignore="MissingTranslation">L\'hai scritto tu, ma non si trova piu\' a chi era diretto: quel contatto non e\' piu\' nella tua lista.</string>
    <string name="cipher_unknown_sender" tools:ignore="MissingTranslation">Mittente sconosciuto</string>
    <string name="cipher_sender_verified" tools:ignore="MissingTranslation">%1$s ✓</string>
    <string name="cipher_composed_at" tools:ignore="MissingTranslation">Scritto il %1$s (secondo il mittente)</string>
    <string name="cipher_card_title" tools:ignore="MissingTranslation">Nuovo contatto</string>
    <string name="cipher_card_pinned" tools:ignore="MissingTranslation">Chiave memorizzata. Confronta questo codice di persona per essere sicuro che sia davvero lui.</string>
    <string name="cipher_unreadable_title" tools:ignore="MissingTranslation">Dati non leggibili</string>
    <string name="cipher_unreadable_identity" tools:ignore="MissingTranslation">La tua identita\' non e\' decifrabile su questo dispositivo. Non e\' stata cambiata: finche\' non decidi tu, resta com\'e\'.</string>
    <string name="cipher_unreadable_keyring" tools:ignore="MissingTranslation">L\'elenco dei contatti non e\' decifrabile. Non e\' stato svuotato: finche\' non decidi tu, resta com\'e\'.</string>

    <!--
        Copia del chiaro. Il messaggio dice dove finisce il testo, perche\' da
        li\' in poi e\' fuori dal perimetro dell\'app: escluso dalla cronologia
        della tastiera, ma leggibile da qualunque app abbia il fuoco.
    -->
    <string name="cipher_copy" tools:ignore="MissingTranslation">Copia</string>
    <string name="cipher_copied" tools:ignore="MissingTranslation">Copiato. Non entra nella cronologia della tastiera, ma resta negli appunti di sistema.</string>

    <!--
        QR per lo scambio di persona. E\' l\'unica via che chiude il MITM al
        primo contatto: il TOFU protegge da li\' in poi, ma quel primo scambio
        resta scoperto se avviene solo dentro il canale che si sta cercando di
        non far leggere a nessuno.
    -->
    <string name="cipher_show_qr" tools:ignore="MissingTranslation">Mostra il codice QR</string>
    <string name="cipher_qr_hint" tools:ignore="MissingTranslation">Fallo inquadrare di persona a chi vuoi contattare. E\' l\'unico modo di essere sicuri che nessuno si sia messo in mezzo al primo scambio.</string>

    <!--
        Backup dell\'identita\'. I testi devono dire due cose che l\'utente non
        puo\' dedurre: che la sicurezza del file dipende SOLO dalla passphrase,
        e che importare sostituisce l\'identita\' attuale.
    -->
    <string name="cipher_backup_export" tools:ignore="MissingTranslation">Salva una copia dell\'identita\'</string>
    <string name="cipher_backup_export_hint" tools:ignore="MissingTranslation">Scegli una passphrase. Il file sara\' protetto SOLO da questa: se e\' debole, lo e\' il backup. Se la dimentichi, il file non si apre piu\' — non esiste un modo di recuperarla.</string>
    <string name="cipher_backup_import" tools:ignore="MissingTranslation">Ripristina da una copia</string>
    <string name="cipher_backup_import_hint" tools:ignore="MissingTranslation">Inserisci la passphrase con cui hai protetto il file.</string>
    <string name="cipher_backup_import_conferma" tools:ignore="MissingTranslation">Questo sostituisce la tua identita\' attuale con quella del file.\n\n• L\'identita\' di adesso non sara\' piu\' recuperabile, se non ne hai un\'altra copia.\n• I messaggi ricevuti finora potrebbero non essere piu\' leggibili.\n• I tuoi contatti vedranno la chiave del file, non quella di adesso.</string>
    <string name="cipher_backup_import_procedi" tools:ignore="MissingTranslation">Sostituisci l\'identita\'</string>
    <string name="cipher_backup_passphrase_vuota" tools:ignore="MissingTranslation">Serve una passphrase</string>
    <string name="cipher_backup_esportato" tools:ignore="MissingTranslation">Copia salvata. Tienila in un posto sicuro: chi ha il file e la passphrase ha la tua identita\'.</string>
    <string name="cipher_backup_importato" tools:ignore="MissingTranslation">Identita\' ripristinata</string>
    <!--
        UN solo messaggio per passphrase sbagliata e file manomesso.
        Distinguerli direbbe a chi prova le passphrase quando ne ha indovinata
        una.
    -->
    <string name="cipher_backup_non_aperto" tools:ignore="MissingTranslation">Non e\' stato possibile aprire il file</string>

    <!--
        Presentazione gia' nota: NON dire "nuovo contatto" e NON mostrare il
        segno di verifica. Quel segno significa "confrontato di persona" ed e\'
        l\'unico segnale anti-MITM del sistema.
    -->
    <string name="cipher_card_known" tools:ignore="MissingTranslation">Contatto gia\' noto</string>
    <string name="cipher_card_known_hint" tools:ignore="MissingTranslation">Questa chiave era gia\' memorizzata. Se non l\'hai ancora fatto, confronta il codice di persona.</string>
    <!--
        Il gesto esplicito che una presentazione non fa al posto dell\'utente:
        non e\' autenticata, quindi non puo\' decidere per chi si cifra.
    -->
    <string name="cipher_use_as_recipient" tools:ignore="MissingTranslation">Scrivi a questo contatto</string>
    <string name="cipher_recipient_set" tools:ignore="MissingTranslation">Ora in questa app cifri per questo contatto</string>

    <!-- ContactsActivity. -->
    <string name="cipher_my_identity" tools:ignore="MissingTranslation">La tua identita\'</string>
    <string name="cipher_my_identity_hint" tools:ignore="MissingTranslation">Questo codice ti identifica. Leggilo a voce a chi vuoi contattare: se combacia, nessuno si e\' interposto.</string>
    <string name="cipher_contacts" tools:ignore="MissingTranslation">Contatti</string>
    <string name="cipher_no_contacts" tools:ignore="MissingTranslation">Nessun contatto. Ne comparira\' uno appena ricevi un messaggio cifrato o una presentazione.</string>
    <string name="cipher_unnamed_peer" tools:ignore="MissingTranslation">Senza nome</string>
    <string name="cipher_first_seen" tools:ignore="MissingTranslation">Visto la prima volta il %1$s</string>
    <string name="cipher_peer_detail" tools:ignore="MissingTranslation">%1$s</string>
    <string name="cipher_assign_label" tools:ignore="MissingTranslation">Dai un nome</string>
    <!--
        Il nome e\' LOCALE: sta su questo telefono e non viaggia con i messaggi.
        Dirlo evita che l\'utente creda di star rinominando qualcuno anche
        dall\'altra parte.
    -->
    <string name="cipher_assign_label_hint" tools:ignore="MissingTranslation">Il nome resta su questo telefono e serve ad accorgersi se un giorno la chiave cambia.</string>
    <string name="cipher_mark_verified" tools:ignore="MissingTranslation">Ho confrontato di persona</string>
    <string name="cipher_mark_verified_body" tools:ignore="MissingTranslation">Conferma solo se hai confrontato questo codice di persona o in una chiamata in cui riconosci la voce:\n\n%1$s</string>

    <!--
        Conflitto di etichetta: il "safety number changed" di Signal.
        Si mostrano ENTRAMBI i fingerprint e si spiegano le due letture senza
        sceglierne una. Non toccare il tono: la lettura innocua e quella
        pericolosa devono restare sullo stesso piano, perche\' da qui nessuno
        puo\' sapere quale delle due sia vera.
    -->
    <string name="cipher_conflict_title" tools:ignore="MissingTranslation">Questo nome e\' gia\' di un\'altra chiave</string>
    <string name="cipher_conflict_body" tools:ignore="MissingTranslation">\"%1$s\" e\' gia\' associato a questa chiave:\n\n%2$s\n\nQuella che stai nominando e\' diversa:\n\n%3$s\n\nPuo\' voler dire due cose: ha reinstallato l\'app o cambiato telefono, oppure qualcuno si sta interponendo. Non c\'e\' modo di distinguerle da qui: chiediglielo su un altro canale.\n\nPer ora non e\' stato cambiato nulla.</string>
    <string name="cipher_conflict_keep" tools:ignore="MissingTranslation">Non cambiare nulla</string>
    <string name="cipher_conflict_replace" tools:ignore="MissingTranslation">E\' la sua chiave nuova</string>
    <string name="cipher_key_replaced" tools:ignore="MissingTranslation">Nome spostato sulla chiave nuova. Va confrontata di nuovo di persona.</string>

    <!--
        Reset dell\'identita\'. Le tre conseguenze vanno tutte e tre nel testo:
        e\' distruzione di dati, e il pulsante che la esegue e\' quello negativo
        apposta.
    -->
    <string name="cipher_reset_identity" tools:ignore="MissingTranslation">Ricomincia da capo</string>
    <string name="cipher_reset_identity_body" tools:ignore="MissingTranslation">Genera una nuova identita\' e butta via quella attuale.\n\n• La vecchia identita\' non e\' recuperabile.\n• I messaggi gia\' ricevuti non saranno piu\' leggibili.\n• Ogni tuo contatto vedra\' che la tua chiave e\' cambiata: lo stesso segnale che indica un tentativo di impersonarti.\n\nFallo solo se non c\'e\' altra via.</string>
    <string name="cipher_reset_identity_confirm" tools:ignore="MissingTranslation">Butta via e ricomincia</string>

    <!--
        Tema dell'Activity che mostra il testo decifrato.

        Parent del framework e non della libreria di supporto: questa Activity
        deve poter comparire sopra qualunque app senza trascinarsi dietro
        dipendenze, e piu' e' semplice meno superficie ha.
    -->
    <style name="Theme.Cipher.Dialog" parent="@android:style/Theme.Material.Light.Dialog">
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
</resources>
